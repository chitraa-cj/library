# Copy to .env and fill in values. Never commit .env.

# --- Required ---
# Local: postgres://USER:PASSWORD@localhost:5432/DB_NAME
# If the password contains # wrap the whole URL in double quotes (otherwise # starts a comment in .env).
# Encode @ in passwords as %40.
# AWS:   Amazon RDS PostgreSQL URL (often append ?sslmode=require)
DATABASE_URL=

# Signs session cookies; use a long random string (e.g. openssl rand -hex 32)
SESSION_SECRET=

# --- Strongly recommended ---
OPENAI_API_KEY=

# --- Optional: Strapi CMS as content source ---
STRAPI_URL=
STRAPI_API_TOKEN=
# Shared secret for POST /api/strapi/webhook and POST /api/strapi/cache/invalidate (set in Strapi webhook headers as x-strapi-webhook-secret).
# STRAPI_WEBHOOK_SECRET=
# In-memory Strapi cache TTL in ms (default 300000 = 5 min). Use 0 to always fetch fresh from Strapi.
# STRAPI_CACHE_TTL_MS=300000
# If Node fails TLS to Strapi with certificate errors, for local dev only (never in production):
# STRAPI_TLS_SKIP_VERIFY=1
# STRAPI_TIMEOUT_MS=20000
# STRAPI_USER_AGENT=MyApp/1.0

# --- Optional: translation scripts only ---
GEMINI_API_KEY=

# --- Replit OIDC (omit on AWS unless you still deploy on Replit) ---
# Without REPL_ID, Replit sign-in is disabled; email/password auth still works.
REPL_ID=
ISSUER_URL=

# --- Server ---
# Local macOS: port 5000 is often taken by AirPlay Receiver; dev defaults to 5050 unless PORT or REPL_ID is set.
# On AWS the platform usually sets PORT (e.g. 8080).
PORT=

# Set automatically by npm scripts; do not override for local dev unless you mean to.
# NODE_ENV=production
